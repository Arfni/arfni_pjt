# Runtime-only Dockerfile for React (GitHub Actions deployment)
# This Dockerfile assumes the app is already built by GitHub Actions
FROM nginx:alpine

# Copy built files from GitHub Actions build
# Assumes files are in ./build or ./dist directory
COPY build /usr/share/nginx/html

# Copy custom nginx config if needed
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE {{ .PORT }}

# Start nginx
CMD ["nginx", "-g", "daemon off;"]