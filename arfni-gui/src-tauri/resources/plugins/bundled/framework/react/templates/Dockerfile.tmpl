# Build stage
FROM node:{{default "18-alpine" .node_version}} AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Normalize output: Vite -> dist/, CRA -> build/
RUN if [ -d dist ]; then mv dist output; \
    elif [ -d build ]; then mv build output; \
    else echo "ERROR: no build output found (expected dist/ or build/)" >&2 && exit 1; fi

# Production stage - nginx serves built static files
FROM nginx:alpine

COPY --from=builder /app/output /usr/share/nginx/html

# SPA routing: unknown paths fall back to index.html for client-side routing
RUN printf 'server {\n\
    listen {{default 3000 .port}};\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE {{default 3000 .port}}
