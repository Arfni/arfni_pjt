# Build stage
FROM node:{{default "18-alpine" .node_version}} AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Production stage - nginx serves built static files
FROM nginx:alpine

# Support both Vite (dist/) and CRA (build/) output directories
COPY --from=builder /app/dist /usr/share/nginx/html
COPY --from=builder /app/build /usr/share/nginx/html 2>/dev/null || true

# SPA routing: unknown paths fall back to index.html for client-side routing
RUN printf 'server {\n\
    listen {{default 3000 .port}};\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE {{default 3000 .port}}
