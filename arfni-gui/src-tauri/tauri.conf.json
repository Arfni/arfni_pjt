{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "arfni-gui",
  "version": "0.1.0",
  "identifier": "com.ssafy.arfni-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arfni",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src 'self' http://localhost:* https://localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://localhost:* https://localhost:* https://raw.githubusercontent.com; connect-src 'self' http://localhost:* https://localhost:* ws://localhost:* wss://localhost:* https://api.github.com https://raw.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/arfni_logo.ico"
    ],
    "resources": {
      "../../BE/arfni/bin/arfni-go.exe": "./",
      "../../BE/arfni/bin/ic.exe": "./",
      "../../BE/arfni/bin/arfni-monitoring.exe": "./",
      "../public/plugins/bundled": "plugins/bundled"
    }
  }
}
